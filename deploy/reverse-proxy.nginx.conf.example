# The React build is served at / by the separate castle-grooves-ui deployment.
# Keep the bot's WEBSERVER_PORT private to this reverse proxy/network.
server {
  listen 443 ssl http2;
  server_name castle-grooves.lan;

  location / {
    proxy_pass http://castle-grooves-ui:80;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /api/v1/ {
    proxy_pass http://castle-grooves-bot:1337;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /auth/ {
    proxy_pass http://castle-grooves-bot:1337;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location = /healthz {
    proxy_pass http://castle-grooves-bot:1337;
  }

  location = /ws {
    proxy_pass http://castle-grooves-bot:1337;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}
