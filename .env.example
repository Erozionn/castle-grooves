# Discord Configuration
CLIENT_ID=
GUILD_ID=
BOT_TOKEN=
ADMIN_USER_ID=
DEFAULT_TEXT_CHANNEL=

# Spotify Configuration
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=US

# InfluxDB Configuration
INFLUX_URL=http://influxdb:8086
INFLUX_TOKEN=
INFLUX_ORG=
INFLUX_BUCKET=
INFLUX_ADMIN_USERNAME=admin
INFLUX_ADMIN_PASSWORD=changeme123

# Lavalink Configuration
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
YOUTUBE_REFRESH_TOKEN=

# Application Configuration
WEBSERVER_PORT=1338
NOW_PLAYING_MOCK_DATA=false
PRELOAD_SONG_DATA=true
LOG_LEVEL=info
# Emits lightweight command, search, and dashboard timing logs.
PERF_LOGGING=false

# React Dashboard / Discord OAuth
# Production uses one HTTPS origin. The redirect URI must exactly match the
# value registered in the Discord Developer Portal.
DASHBOARD_PUBLIC_URL=https://castle-grooves.lan
# Local React development only; leave blank in production.
DASHBOARD_DEV_ORIGIN=http://localhost:5173
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=https://castle-grooves.lan/auth/discord/callback
# Use at least 32 random characters; do not reuse BOT_TOKEN or OAuth secrets.
DASHBOARD_SESSION_SECRET=
# Comma-separated Discord user IDs. Precedence: admin > DJ > viewer.
DASHBOARD_ADMIN_DISCORD_USER_IDS=
DASHBOARD_DJ_DISCORD_USER_IDS=
DASHBOARD_VIEWER_DISCORD_USER_IDS=

# Grafana Configuration
# Set this to the LAN-accessible URL for the bot's HTTP API (for dashboard Play Song links).
BOT_PUBLIC_URL=http://192.168.1.100:1337
# Grafana can continue reading Influx history. Dashboard controls now use the
# authenticated React API rather than Grafana's former /control endpoints.
GRAFANA_PUBLIC_URL=http://192.168.1.100:3000
GRAFANA_PORT=3000

# Voice Command Configuration
VOICE_COMMANDS_ENABLED=false
VOICE_HELLO_RESPONSES_ENABLED=false
VOICE_WAKE_WORD_CONFIRM_SOUND_ENABLED=false
VOICE_LISTENER_BOT_TOKEN=
VOSK_MODEL_PATH=./models/vosk-model-small-en-us
VOICE_WAKE_PHRASE=castle grooves
VOICE_CAPTURE_TIMEOUT_MS=7000
VOICE_SILENCE_MS=1200

# Docker Production
DOCKER_HUB_USERNAME=
TZ=America/Toronto
