{
  "uid": "castle-grooves-dj-console",
  "title": "DJ Console",
  "tags": ["castle-grooves", "dj", "live"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "editable": true,
  "graphTooltip": 0,
  "panels": [
    {
      "id": 1,
      "type": "canvas",
      "title": "Now Playing",
      "transparent": true,
      "datasource": { "type": "influxdb", "uid": "castle-grooves-influxdb" },
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 13 },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: -2h)\n  |> filter(fn: (r) => r._measurement == \"playback_snapshot\")\n  |> pivot(rowKey: [\"_time\", \"guildId\", \"status\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()\n  |> sort(columns: [\"_time\"], desc: true)\n  |> limit(n: 1)\n  |> map(fn: (r) => ({Artwork: r.artworkUrl, Track: if r.title == \"\" then \"Nothing is playing\" else r.title, Artist: r.artist, Requester: r.requesterName, State: r.status, Duration: r.durationLabel, QueueDepth: r.queueDepth}))"
        }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": {
        "inlineEditing": true,
        "showAdvancedTypes": true,
        "panZoom": false,
        "zoomToContent": true,
        "tooltip": { "mode": "none" },
        "root": {
          "name": "DJ Console",
          "type": "frame",
          "elements": [
            {
              "name": "Artwork",
              "type": "rectangle",
              "placement": { "left": 26, "top": 24, "width": 310, "height": 310 },
              "background": { "color": { "fixed": "#20142f" }, "image": { "mode": "field", "field": "Artwork" }, "size": "cover" },
              "border": { "color": { "fixed": "#8b5cf6" }, "width": 1, "radius": 12 }
            },
            {
              "name": "Live label",
              "type": "text",
              "placement": { "left": 370, "top": 38, "width": 480, "height": 30 },
              "config": { "text": { "mode": "fixed", "fixed": "LIVE IN CASTLE GROOVES" }, "align": "left", "valign": "middle", "size": 14, "color": { "fixed": "#a78bfa" } }
            },
            {
              "name": "Track",
              "type": "metric-value",
              "placement": { "left": 370, "top": 76, "width": 560, "height": 70 },
              "config": { "text": { "mode": "field", "field": "Track" }, "align": "left", "valign": "middle", "size": 32, "color": { "fixed": "#f8fafc" } }
            },
            {
              "name": "Artist",
              "type": "metric-value",
              "placement": { "left": 370, "top": 146, "width": 500, "height": 42 },
              "config": { "text": { "mode": "field", "field": "Artist" }, "align": "left", "valign": "middle", "size": 19, "color": { "fixed": "#cbd5e1" } }
            },
            {
              "name": "Requested label",
              "type": "text",
              "placement": { "left": 370, "top": 200, "width": 120, "height": 25 },
              "config": { "text": { "mode": "fixed", "fixed": "REQUESTED BY" }, "align": "left", "valign": "middle", "size": 12, "color": { "fixed": "#94a3b8" } }
            },
            {
              "name": "Requester",
              "type": "metric-value",
              "placement": { "left": 370, "top": 225, "width": 340, "height": 40 },
              "config": { "text": { "mode": "field", "field": "Requester" }, "align": "left", "valign": "middle", "size": 18, "color": { "fixed": "#f1f5f9" } }
            },
            {
              "name": "State",
              "type": "metric-value",
              "placement": { "left": 750, "top": 198, "width": 170, "height": 40 },
              "config": { "text": { "mode": "field", "field": "State" }, "align": "center", "valign": "middle", "size": 16, "color": { "fixed": "#86efac" } },
              "background": { "color": { "fixed": "#173227" } },
              "border": { "color": { "fixed": "#2f855a" }, "width": 1, "radius": 18 }
            },
            {
              "name": "Duration",
              "type": "metric-value",
              "placement": { "left": 750, "top": 248, "width": 170, "height": 36 },
              "config": { "text": { "mode": "field", "field": "Duration" }, "align": "center", "valign": "middle", "size": 16, "color": { "fixed": "#cbd5e1" } },
              "background": { "color": { "fixed": "#20293a" } },
              "border": { "color": { "fixed": "#475569" }, "width": 1, "radius": 16 }
            },
            {
              "name": "Queue label",
              "type": "text",
              "placement": { "left": 370, "top": 283, "width": 120, "height": 28 },
              "config": { "text": { "mode": "fixed", "fixed": "UP NEXT" }, "align": "left", "valign": "middle", "size": 12, "color": { "fixed": "#94a3b8" } }
            },
            {
              "name": "Queue depth",
              "type": "metric-value",
              "placement": { "left": 480, "top": 276, "width": 78, "height": 40 },
              "config": { "text": { "mode": "field", "field": "QueueDepth" }, "align": "left", "valign": "middle", "size": 20, "color": { "fixed": "#f8fafc" } }
            },
            {
              "name": "Pause",
              "type": "button",
              "placement": { "left": 370, "top": 348, "width": 135, "height": 44 },
              "config": { "text": { "mode": "fixed", "fixed": "Pause" }, "align": "center", "size": 15, "color": { "fixed": "#f8fafc" }, "style": { "variant": "secondary" }, "api": { "endpoint": "__BOT_PUBLIC_URL__/control/pause", "method": "POST", "data": "{}", "contentType": "application/json", "queryParams": [], "headerParams": [], "successMessage": "Pause requested." } }
            },
            {
              "name": "Resume",
              "type": "button",
              "placement": { "left": 518, "top": 348, "width": 135, "height": 44 },
              "config": { "text": { "mode": "fixed", "fixed": "Resume" }, "align": "center", "size": 15, "color": { "fixed": "#f8fafc" }, "style": { "variant": "primary" }, "api": { "endpoint": "__BOT_PUBLIC_URL__/control/resume", "method": "POST", "data": "{}", "contentType": "application/json", "queryParams": [], "headerParams": [], "successMessage": "Resume requested." } }
            },
            {
              "name": "Skip",
              "type": "button",
              "placement": { "left": 666, "top": 348, "width": 135, "height": 44 },
              "config": { "text": { "mode": "fixed", "fixed": "Skip" }, "align": "center", "size": 15, "color": { "fixed": "#f8fafc" }, "style": { "variant": "secondary" }, "api": { "endpoint": "__BOT_PUBLIC_URL__/control/skip", "method": "POST", "data": "{}", "contentType": "application/json", "queryParams": [], "headerParams": [], "successMessage": "Skip requested." } }
            },
            {
              "name": "Stop",
              "type": "button",
              "placement": { "left": 814, "top": 348, "width": 135, "height": 44 },
              "config": { "text": { "mode": "fixed", "fixed": "Stop & Disconnect" }, "align": "center", "size": 14, "color": { "fixed": "#fef2f2" }, "style": { "variant": "destructive" }, "api": { "endpoint": "__BOT_PUBLIC_URL__/control/stop", "method": "POST", "data": "{}", "contentType": "application/json", "queryParams": [], "headerParams": [], "successMessage": "Queue cleared and bot disconnected." } }
            }
          ]
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Bot",
      "datasource": { "type": "influxdb", "uid": "castle-grooves-influxdb" },
      "gridPos": { "x": 0, "y": 13, "w": 6, "h": 3 },
      "targets": [{ "refId": "A", "query": "from(bucket: v.defaultBucket)\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"bot_runtime\" and r._field == \"up\")\n  |> group()\n  |> last()" }],
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "true": { "text": "Online", "color": "green" } } }], "noValue": "Offline" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "horizontal", "textMode": "value", "colorMode": "value", "graphMode": "none" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Lavalink",
      "datasource": { "type": "influxdb", "uid": "castle-grooves-influxdb" },
      "gridPos": { "x": 6, "y": 13, "w": 6, "h": 3 },
      "targets": [{ "refId": "A", "query": "from(bucket: v.defaultBucket)\n  |> range(start: -30d)\n  |> filter(fn: (r) => r._measurement == \"lavalink_state\" and r._field == \"connected\")\n  |> group()\n  |> last()" }],
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "true": { "text": "Connected", "color": "green" }, "false": { "text": "Disconnected", "color": "red" } } }], "noValue": "Unknown" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "horizontal", "textMode": "value", "colorMode": "value", "graphMode": "none" }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Active Queues",
      "datasource": { "type": "influxdb", "uid": "castle-grooves-influxdb" },
      "gridPos": { "x": 12, "y": 13, "w": 6, "h": 3 },
      "targets": [{ "refId": "A", "query": "from(bucket: v.defaultBucket)\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"bot_runtime\" and r._field == \"activeQueues\")\n  |> group()\n  |> last()" }],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "horizontal", "textMode": "value", "colorMode": "value", "graphMode": "none" }
    },
    {
      "id": 5,
      "type": "canvas",
      "title": "",
      "transparent": true,
      "gridPos": { "x": 18, "y": 13, "w": 6, "h": 3 },
      "targets": [],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "inlineEditing": true, "showAdvancedTypes": true, "panZoom": false, "zoomToContent": true, "tooltip": { "mode": "none" }, "root": { "name": "Navigation", "type": "frame", "elements": [{ "name": "Listening Recap", "type": "text", "placement": { "left": 20, "top": 20, "width": 330, "height": 70 }, "config": { "text": { "mode": "fixed", "fixed": "Open Listening Recap  →" }, "align": "center", "valign": "middle", "size": 18, "color": { "fixed": "#c4b5fd" } }, "background": { "color": { "fixed": "#21183a" } }, "border": { "color": { "fixed": "#6d4aff" }, "width": 1, "radius": 10 }, "links": [{ "title": "Open Listening Recap", "url": "/d/castle-grooves-recap/listening-recap", "targetBlank": false }] }] } }
    }
  ]
}
