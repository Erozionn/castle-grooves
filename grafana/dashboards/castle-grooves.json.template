{
  "uid": "castle-grooves-overview",
  "title": "Castle Grooves",
  "tags": ["castle-grooves", "music", "discord"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 2,
  "refresh": "1m",
  "time": { "from": "now-30d", "to": "now" },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Latest Song",
      "datasource": { "type": "influxdb", "uid": "castle-grooves-influxdb" },
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 5 },
      "targets": [{ "refId": "A", "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"song_play\" and r._field == \"songTitle\")\n  |> group()\n  |> last()\n  |> keep(columns: [\"_value\"])" }],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value", "colorMode": "value", "graphMode": "none" }
    },
    {
      "id": 2, "type": "stat", "title": "Songs Played",
      "datasource": { "type": "influxdb", "uid": "castle-grooves-influxdb" },
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 5 },
      "targets": [{ "refId": "A", "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"song_play\" and r._field == \"songTitle\")\n  |> group()\n  |> count(column: \"_value\")" }],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "green" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none" }
    },
    {
      "id": 3, "type": "stat", "title": "Unique Requesters",
      "datasource": { "type": "influxdb", "uid": "castle-grooves-influxdb" },
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 5 },
      "targets": [{ "refId": "A", "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"song_play\" and r._field == \"songTitle\")\n  |> group()\n  |> unique(column: \"requestedById\")\n  |> count(column: \"_value\")" }],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "purple" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none" }
    },
    {
      "id": 4, "type": "stat", "title": "Bot Heartbeat",
      "description": "The new bot image reports every minute.",
      "datasource": { "type": "influxdb", "uid": "castle-grooves-influxdb" },
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 5 },
      "targets": [{ "refId": "A", "query": "from(bucket: v.defaultBucket)\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"bot_runtime\" and r._field == \"up\")\n  |> group()\n  |> last()" }],
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "true": { "text": "Online", "color": "green" } } }], "noValue": "Offline" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none" }
    },
    {
      "id": 5, "type": "stat", "title": "Lavalink",
      "datasource": { "type": "influxdb", "uid": "castle-grooves-influxdb" },
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 5 },
      "targets": [{ "refId": "A", "query": "from(bucket: v.defaultBucket)\n  |> range(start: -30d)\n  |> filter(fn: (r) => r._measurement == \"lavalink_state\" and r._field == \"connected\")\n  |> group()\n  |> last()" }],
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "true": { "text": "Connected", "color": "green" }, "false": { "text": "Disconnected", "color": "red" } } }], "noValue": "Unknown" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none" }
    },
    {
      "id": 6, "type": "timeseries", "title": "Listening Activity",
      "datasource": { "type": "influxdb", "uid": "castle-grooves-influxdb" },
      "gridPos": { "x": 0, "y": 5, "w": 24, "h": 8 },
      "targets": [{ "refId": "A", "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"song_play\" and r._field == \"songTitle\")\n  |> group()\n  |> aggregateWindow(every: v.windowPeriod, fn: count, createEmpty: false)\n  |> set(key: \"_field\", value: \"Plays\")" }],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "blue" }, "custom": { "drawStyle": "bars", "fillOpacity": 55, "lineWidth": 1, "showPoints": "never" }, "min": 0 }, "overrides": [] },
      "options": { "legend": { "showLegend": false }, "tooltip": { "mode": "single" } }
    },
    {
      "id": 7, "type": "table", "title": "Top Songs",
      "description": "Click a title to queue that song.",
      "datasource": { "type": "influxdb", "uid": "castle-grooves-influxdb" },
      "gridPos": { "x": 0, "y": 13, "w": 12, "h": 10 },
      "targets": [{ "refId": "A", "query": "plays = from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"song_play\" and r._field == \"songTitle\")\n  |> group(columns: [\"songHash\"])\n  |> count(column: \"_value\")\n  |> rename(columns: {_value: \"Plays\"})\ntitles = from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"song_play\" and r._field == \"songTitle\")\n  |> group(columns: [\"songHash\"])\n  |> last()\n  |> keep(columns: [\"songHash\", \"_value\"])\n  |> rename(columns: {_value: \"Song\"})\njoin(tables: {plays: plays, titles: titles}, on: [\"songHash\"])\n  |> map(fn: (r) => ({Song: r.Song, Plays: r.Plays}))\n  |> group()\n  |> sort(columns: [\"Plays\"], desc: true)\n  |> limit(n: 15)" }],
      "fieldConfig": { "defaults": {}, "overrides": [{ "matcher": { "id": "byName", "options": "Song" }, "properties": [{ "id": "links", "value": [{ "title": "Play Song", "targetBlank": true, "url": "__BOT_PUBLIC_URL__/play?query=${__data.fields[\"Song\"]:percentencode}" }] }] }] },
      "options": { "showHeader": true, "cellHeight": "sm", "footer": { "show": false }, "sortBy": [{ "displayName": "Plays", "desc": true }] }
    },
    {
      "id": 8, "type": "barchart", "title": "Top Requesters",
      "datasource": { "type": "influxdb", "uid": "castle-grooves-influxdb" },
      "gridPos": { "x": 12, "y": 13, "w": 6, "h": 10 },
      "targets": [{ "refId": "A", "query": "requests = from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"song_play\" and r._field == \"songTitle\")\n  |> group(columns: [\"requestedById\"])\n  |> count(column: \"_value\")\n  |> keep(columns: [\"requestedById\", \"_value\"])\n  |> rename(columns: {_value: \"Plays\"})\nusers = from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"song_play\" and r._field == \"requestedByUsername\")\n  |> group(columns: [\"requestedById\"])\n  |> last()\n  |> keep(columns: [\"requestedById\", \"_value\"])\n  |> rename(columns: {_value: \"Requester\"})\njoin(tables: {requests: requests, users: users}, on: [\"requestedById\"])\n  |> map(fn: (r) => ({Requester: r.Requester, Plays: r.Plays}))\n  |> group()\n  |> sort(columns: [\"Plays\"], desc: true)\n  |> limit(n: 10)" }],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "purple" } }, "overrides": [] },
      "options": { "orientation": "horizontal", "xField": "Requester", "showValue": "auto", "legend": { "showLegend": false } }
    },
    {
      "id": 9, "type": "piechart", "title": "Playback Sources",
      "datasource": { "type": "influxdb", "uid": "castle-grooves-influxdb" },
      "gridPos": { "x": 18, "y": 13, "w": 6, "h": 10 },
      "targets": [{ "refId": "A", "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"song_play\" and r._field == \"songTitle\")\n  |> group(columns: [\"source\"])\n  |> count(column: \"_value\")\n  |> map(fn: (r) => ({Source: r.source, Plays: r._value}))\n  |> group()" }],
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" } }, "overrides": [] },
      "options": { "displayLabels": ["name", "percent"], "legend": { "displayMode": "list", "placement": "right", "showLegend": true }, "pieType": "donut" }
    },
    {
      "id": 10, "type": "table", "title": "Recent Song History",
      "description": "Click a title to queue that song.",
      "datasource": { "type": "influxdb", "uid": "castle-grooves-influxdb" },
      "gridPos": { "x": 0, "y": 23, "w": 24, "h": 10 },
      "targets": [{ "refId": "A", "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"song_play\")\n  |> filter(fn: (r) => r._field == \"songTitle\" or r._field == \"requestedByUsername\")\n  |> pivot(rowKey: [\"_time\", \"requestedById\", \"songHash\", \"source\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> keep(columns: [\"_time\", \"songTitle\", \"requestedByUsername\", \"source\"])\n  |> rename(columns: {songTitle: \"Song\", requestedByUsername: \"Requested By\", source: \"Source\"})\n  |> sort(columns: [\"_time\"], desc: true)\n  |> limit(n: 25)" }],
      "fieldConfig": { "defaults": {}, "overrides": [{ "matcher": { "id": "byName", "options": "Song" }, "properties": [{ "id": "links", "value": [{ "title": "Play Song", "targetBlank": true, "url": "__BOT_PUBLIC_URL__/play?query=${__data.fields[\"Song\"]:percentencode}" }] }] }] },
      "options": { "showHeader": true, "cellHeight": "sm", "footer": { "show": false }, "sortBy": [{ "displayName": "Time", "desc": true }] }
    },
    {
      "id": 11, "type": "state-timeline", "title": "Voice Channel Activity",
      "datasource": { "type": "influxdb", "uid": "castle-grooves-influxdb" },
      "gridPos": { "x": 0, "y": 33, "w": 16, "h": 11 },
      "targets": [{ "refId": "A", "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"userVoiceStatus\" and r._field == \"voiceStateConnected\")\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)\n  |> keep(columns: [\"_time\", \"username\", \"_value\"])" }],
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "true": { "text": "Connected", "color": "green" }, "false": { "text": "Disconnected", "color": "transparent" } } }] }, "overrides": [] },
      "options": { "alignValue": "center", "legend": { "showLegend": false }, "mergeValues": true, "rowHeight": 0.9, "showValue": "never" }
    },
    {
      "id": 12, "type": "table", "title": "Currently Connected",
      "datasource": { "type": "influxdb", "uid": "castle-grooves-influxdb" },
      "gridPos": { "x": 16, "y": 33, "w": 8, "h": 11 },
      "targets": [{ "refId": "A", "query": "from(bucket: v.defaultBucket)\n  |> range(start: -30d)\n  |> filter(fn: (r) => r._measurement == \"userVoiceStatus\" and r._field == \"voiceStateConnected\")\n  |> group(columns: [\"userId\"])\n  |> last()\n  |> filter(fn: (r) => r._value == true)\n  |> map(fn: (r) => ({Member: r.username, VoiceChannel: r.voiceChannelName, LastSeen: r._time}))\n  |> keep(columns: [\"Member\", \"VoiceChannel\", \"LastSeen\"])" }],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "showHeader": true, "cellHeight": "sm", "footer": { "show": false } }
    },
    {
      "id": 13, "type": "heatmap", "title": "Popular Listening Times",
      "description": "Brighter cells mean more tracks started in that hour.",
      "datasource": { "type": "influxdb", "uid": "castle-grooves-influxdb" },
      "gridPos": { "x": 0, "y": 44, "w": 24, "h": 9 },
      "targets": [{ "refId": "A", "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"song_play\" and r._field == \"songTitle\")\n  |> group()\n  |> aggregateWindow(every: 1h, fn: count, createEmpty: true)\n  |> set(key: \"_field\", value: \"Plays per hour\")" }],
      "dataFormat": "tsbuckets",
      "fieldConfig": { "defaults": { "color": { "mode": "continuous-GrYlRd" } }, "overrides": [] },
      "options": { "calculate": false, "cellGap": 1, "cellRadius": 2, "color": { "mode": "scheme", "scheme": "Oranges", "steps": 32 }, "filterValues": { "le": 0 }, "legend": { "show": true }, "showValue": "never", "tooltip": { "show": true, "yHistogram": false }, "yAxis": { "axisPlacement": "left", "reverse": false, "unit": "short" } }
    }
  ]
}
