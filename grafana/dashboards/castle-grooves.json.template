{
  "uid": "castle-grooves-overview",
  "title": "Castle Grooves",
  "tags": ["castle-grooves", "music", "discord"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-7d", "to": "now" },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Service Health",
      "description": "The bot reports every minute; Lavalink reports lifecycle transitions.",
      "datasource": { "type": "influxdb", "uid": "castle-grooves-influxdb" },
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 5 },
      "targets": [
        { "refId": "A", "query": "from(bucket: v.defaultBucket)\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"bot_runtime\" and r._field == \"up\")\n  |> last()" },
        { "refId": "B", "query": "from(bucket: v.defaultBucket)\n  |> range(start: -30d)\n  |> filter(fn: (r) => r._measurement == \"lavalink_state\" and r._field == \"connected\")\n  |> last()" }
      ],
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "1": { "text": "Online", "color": "green" } } }], "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "none", "justifyMode": "auto" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Playback State",
      "datasource": { "type": "influxdb", "uid": "castle-grooves-influxdb" },
      "gridPos": { "x": 6, "y": 0, "w": 3, "h": 5 },
      "targets": [{ "refId": "A", "query": "from(bucket: v.defaultBucket)\n  |> range(start: -30d)\n  |> filter(fn: (r) => r._measurement == \"bot_state\" and r._field == \"playbackState\")\n  |> last()" }],
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "playing": { "text": "Playing", "color": "green" }, "idle": { "text": "Idle", "color": "yellow" }, "stopped": { "text": "Stopped", "color": "red" } } }] }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "none", "justifyMode": "auto" }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Active Queues",
      "datasource": { "type": "influxdb", "uid": "castle-grooves-influxdb" },
      "gridPos": { "x": 9, "y": 0, "w": 3, "h": 5 },
      "targets": [{ "refId": "A", "query": "from(bucket: v.defaultBucket)\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"bot_runtime\" and r._field == \"activeQueues\")\n  |> last()" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Listening Summary",
      "datasource": { "type": "influxdb", "uid": "castle-grooves-influxdb" },
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 5 },
      "targets": [
        { "refId": "A", "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"song_play\" and r._field == \"songTitle\")\n  |> count()" },
        { "refId": "B", "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"song_play\" and r._field == \"songTitle\")\n  |> distinct(column: \"requestedById\")\n  |> count(column: \"requestedById\")" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Latest Song",
      "datasource": { "type": "influxdb", "uid": "castle-grooves-influxdb" },
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 5 },
      "targets": [{ "refId": "A", "query": "from(bucket: v.defaultBucket)\n  |> range(start: -30d)\n  |> filter(fn: (r) => r._measurement == \"song_play\" and r._field == \"songTitle\")\n  |> last()" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "value", "colorMode": "none", "graphMode": "none", "justifyMode": "auto" },
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Plays Over Time",
      "datasource": { "type": "influxdb", "uid": "castle-grooves-influxdb" },
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 8 },
      "targets": [{ "refId": "A", "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"song_play\" and r._field == \"songTitle\")\n  |> aggregateWindow(every: v.windowPeriod, fn: count, createEmpty: false)\n  |> yield(name: \"plays\")" }],
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "bars", "fillOpacity": 35, "lineWidth": 1, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false }, "tooltip": { "mode": "single", "sort": "none" } }
    },
    {
      "id": 9,
      "type": "heatmap",
      "title": "Hourly Play Heatmap",
      "datasource": { "type": "influxdb", "uid": "castle-grooves-influxdb" },
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 8 },
      "targets": [{ "refId": "A", "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"song_play\" and r._field == \"songTitle\")\n  |> aggregateWindow(every: 1h, fn: count, createEmpty: false)\n  |> yield(name: \"hourly_plays\")" }],
      "dataFormat": "tsbuckets",
      "options": { "calculate": false, "cellGap": 1, "cellRadius": 0, "color": { "mode": "scheme", "scheme": "Oranges", "steps": 64 }, "exemplars": { "color": "rgba(255,0,255,0.7)" }, "filterValues": { "le": 1e-9 }, "legend": { "show": true }, "rowsFrame": { "layout": "auto" }, "showValue": "never", "tooltip": { "show": true, "yHistogram": false }, "yAxis": { "axisPlacement": "left", "reverse": false, "unit": "short" } }
    },
    {
      "id": 10,
      "type": "table",
      "title": "Top Songs",
      "description": "Click a song to queue it for the configured dashboard DJ.",
      "datasource": { "type": "influxdb", "uid": "castle-grooves-influxdb" },
      "gridPos": { "x": 0, "y": 13, "w": 12, "h": 9 },
      "targets": [{ "refId": "A", "query": "plays = from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"song_play\" and r._field == \"songTitle\")\n  |> group(columns: [\"songHash\"])\n  |> count(column: \"_value\")\n  |> rename(columns: {_value: \"Plays\"})\n\ntitles = from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"song_play\" and r._field == \"songTitle\")\n  |> group(columns: [\"songHash\"])\n  |> last()\n  |> keep(columns: [\"songHash\", \"_value\"])\n  |> rename(columns: {_value: \"Song\"})\n\njoin(tables: {plays: plays, titles: titles}, on: [\"songHash\"])\n  |> keep(columns: [\"Song\", \"Plays\"])\n  |> sort(columns: [\"Plays\"], desc: true)\n  |> limit(n: 20)" }],
      "fieldConfig": { "defaults": {}, "overrides": [{ "matcher": { "id": "byName", "options": "Song" }, "properties": [{ "id": "links", "value": [{ "title": "Play Song", "targetBlank": true, "url": "__BOT_PUBLIC_URL__/play?query=${__data.fields[\"Song\"]:percentencode}" }] }] }] },
      "options": { "showHeader": true, "cellHeight": "sm", "footer": { "show": false }, "sortBy": [{ "displayName": "Plays", "desc": true }] }
    },
    {
      "id": 11,
      "type": "barchart",
      "title": "Top Requesters",
      "datasource": { "type": "influxdb", "uid": "castle-grooves-influxdb" },
      "gridPos": { "x": 12, "y": 13, "w": 6, "h": 9 },
      "targets": [{ "refId": "A", "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"song_play\" and r._field == \"songTitle\")\n  |> group(columns: [\"requestedById\", \"requestedByUsername\"])\n  |> count()\n  |> keep(columns: [\"requestedByUsername\", \"_value\"])\n  |> rename(columns: {_value: \"Plays\"})\n  |> sort(columns: [\"Plays\"], desc: true)\n  |> limit(n: 10)" }],
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" } }, "overrides": [] },
      "options": { "orientation": "auto", "xField": "requestedByUsername", "showValue": "auto", "stacking": "none", "legend": { "displayMode": "hidden", "placement": "bottom", "showLegend": false }, "tooltip": { "mode": "single", "sort": "none" } }
    },
    {
      "id": 12,
      "type": "piechart",
      "title": "Playback Sources",
      "datasource": { "type": "influxdb", "uid": "castle-grooves-influxdb" },
      "gridPos": { "x": 18, "y": 13, "w": 6, "h": 9 },
      "targets": [{ "refId": "A", "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"song_play\" and r._field == \"songTitle\")\n  |> group(columns: [\"source\"])\n  |> count()\n  |> keep(columns: [\"source\", \"_value\"])\n  |> rename(columns: {_value: \"Plays\"})" }],
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" } }, "overrides": [] },
      "options": { "displayLabels": ["name", "percent"], "legend": { "displayMode": "list", "placement": "right", "showLegend": true }, "pieType": "donut", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "tooltip": { "mode": "single", "sort": "none" } }
    },
    {
      "id": 13,
      "type": "table",
      "title": "Recent Song History",
      "description": "Click a song to queue it for the configured dashboard DJ.",
      "datasource": { "type": "influxdb", "uid": "castle-grooves-influxdb" },
      "gridPos": { "x": 0, "y": 22, "w": 12, "h": 10 },
      "targets": [{ "refId": "A", "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"song_play\" and r._field == \"songTitle\")\n  |> keep(columns: [\"_time\", \"_value\", \"requestedByUsername\", \"source\"])\n  |> rename(columns: {_value: \"Song\", requestedByUsername: \"Requested By\", source: \"Source\"})\n  |> sort(columns: [\"_time\"], desc: true)\n  |> limit(n: 30)" }],
      "fieldConfig": { "defaults": {}, "overrides": [{ "matcher": { "id": "byName", "options": "Song" }, "properties": [{ "id": "links", "value": [{ "title": "Play Song", "targetBlank": true, "url": "__BOT_PUBLIC_URL__/play?query=${__data.fields[\"Song\"]:percentencode}" }] }] }] },
      "options": { "showHeader": true, "cellHeight": "sm", "footer": { "show": false }, "sortBy": [{ "displayName": "Time", "desc": true }] }
    },
    {
      "id": 14,
      "type": "state-timeline",
      "title": "Connected Members Timeline",
      "datasource": { "type": "influxdb", "uid": "castle-grooves-influxdb" },
      "gridPos": { "x": 12, "y": 22, "w": 12, "h": 10 },
      "targets": [{ "refId": "A", "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"userVoiceStatus\" and r._field == \"voiceStateConnected\")\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)\n  |> keep(columns: [\"_time\", \"username\", \"_value\"])" }],
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "true": { "text": "Connected", "color": "green" }, "false": { "text": "Disconnected", "color": "transparent" } } }] }, "overrides": [] },
      "options": { "alignValue": "center", "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false }, "mergeValues": true, "rowHeight": 0.9, "showValue": "never", "tooltip": { "mode": "single", "sort": "none" } }
    },
    {
      "id": 15,
      "type": "table",
      "title": "Currently Connected Members",
      "datasource": { "type": "influxdb", "uid": "castle-grooves-influxdb" },
      "gridPos": { "x": 0, "y": 32, "w": 8, "h": 8 },
      "targets": [{ "refId": "A", "query": "from(bucket: v.defaultBucket)\n  |> range(start: -30d)\n  |> filter(fn: (r) => r._measurement == \"userVoiceStatus\" and r._field == \"voiceStateConnected\")\n  |> group(columns: [\"userId\", \"username\", \"voiceChannelName\"])\n  |> last()\n  |> filter(fn: (r) => r._value == true)\n  |> keep(columns: [\"username\", \"voiceChannelName\", \"_time\"])\n  |> rename(columns: {username: \"Member\", voiceChannelName: \"Voice Channel\"})" }],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "showHeader": true, "cellHeight": "sm", "footer": { "show": false } }
    },
    {
      "id": 16,
      "type": "table",
      "title": "Most Disliked Songs",
      "datasource": { "type": "influxdb", "uid": "castle-grooves-influxdb" },
      "gridPos": { "x": 8, "y": 32, "w": 8, "h": 8 },
      "targets": [{ "refId": "A", "query": "votes = from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"song_feedback\" and r._field == \"thumbsDown\")\n  |> group(columns: [\"songIdentifier\"])\n  |> sum()\n  |> rename(columns: {_value: \"Dislikes\"})\n\ntitles = from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"song_feedback\" and r._field == \"songTitle\")\n  |> group(columns: [\"songIdentifier\"])\n  |> last()\n  |> keep(columns: [\"songIdentifier\", \"_value\"])\n  |> rename(columns: {_value: \"Song\"})\n\njoin(tables: {votes: votes, titles: titles}, on: [\"songIdentifier\"])\n  |> keep(columns: [\"Song\", \"Dislikes\"])\n  |> sort(columns: [\"Dislikes\"], desc: true)\n  |> limit(n: 10)" }],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "showHeader": true, "cellHeight": "sm", "footer": { "show": false }, "sortBy": [{ "displayName": "Dislikes", "desc": true }] }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Queue Activity",
      "datasource": { "type": "influxdb", "uid": "castle-grooves-influxdb" },
      "gridPos": { "x": 16, "y": 32, "w": 8, "h": 8 },
      "targets": [
        { "refId": "A", "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"bot_runtime\" and r._field == \"activeQueues\")\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)" },
        { "refId": "B", "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"bot_runtime\" and r._field == \"playingQueues\")\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)" }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "none" } }
    },
    {
      "id": 18,
      "type": "state-timeline",
      "title": "Lavalink Transitions",
      "datasource": { "type": "influxdb", "uid": "castle-grooves-influxdb" },
      "gridPos": { "x": 0, "y": 40, "w": 24, "h": 7 },
      "targets": [{ "refId": "A", "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"lavalink_state\" and r._field == \"connectionState\")\n  |> keep(columns: [\"_time\", \"node\", \"_value\"])" }],
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "ready": { "text": "Ready", "color": "green" }, "disconnected": { "text": "Disconnected", "color": "red" }, "closed": { "text": "Closed", "color": "orange" }, "error": { "text": "Error", "color": "red" } } }] }, "overrides": [] },
      "options": { "alignValue": "center", "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false }, "mergeValues": true, "rowHeight": 0.9, "showValue": "auto", "tooltip": { "mode": "single", "sort": "none" } }
    }
  ]
}
